<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Spendy.Views.EditSavingPlanPage"
             Shell.NavBarIsVisible="False"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#01143D">
    <Grid RowDefinitions="Auto,*">
        <Grid Grid.Row="0" Padding="16,12,16,18" RowDefinitions="Auto,Auto" RowSpacing="10">
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto">
                <Border WidthRequest="44"
                        HeightRequest="44"
                        StrokeThickness="0"
                        BackgroundColor="#1AFFFFFF">
                    <Border.StrokeShape>
                        <Ellipse />
                    </Border.StrokeShape>
                    <Image Source="{Binding ProfilePhoto}"
                           Aspect="AspectFill" />
                </Border>
                <Border Grid.Column="2"
                        WidthRequest="44"
                        HeightRequest="44"
                        StrokeThickness="0"
                        BackgroundColor="Transparent"
                        VerticalOptions="Center">
                    <Border.StrokeShape>
                        <Ellipse />
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnNotificationsTapped" />
                    </Border.GestureRecognizers>
                    <Image Source="whitenotificon.png"
                           WidthRequest="24"
                           HeightRequest="24"
                           Aspect="AspectFit"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           InputTransparent="True" />
                </Border>
            </Grid>
            <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto">
                <Button Text="&#x2039;"
                        FontSize="26"
                        TextColor="White"
                        BackgroundColor="Transparent"
                        WidthRequest="44"
                        Clicked="OnBack" />
                <Label Grid.Column="1"
                       Text="Edit Saving Plan"
                       TextColor="White"
                       FontFamily="OpenSansSemibold"
                       FontSize="20"
                       HorizontalTextAlignment="Center"
                       VerticalOptions="Center" />
                <Grid Grid.Column="2"
                      WidthRequest="44"
                      HeightRequest="44" />
            </Grid>
        </Grid>

        <Grid Grid.Row="1">
            <Border BackgroundColor="{StaticResource SpendyDarkSheet}"
                    StrokeThickness="0"
                    Margin="0,-16,0,0"
                    Padding="16,18,16,20">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="28,28,0,0" />
                </Border.StrokeShape>
                <ScrollView Margin="0,0,2,0">
                    <VerticalStackLayout Spacing="16" Padding="0,0,0,18">
                        <Border StrokeThickness="0"
                                BackgroundColor="{StaticResource SpendyDarkInput}"
                                Padding="16,0"
                                HeightRequest="54">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="22" />
                            </Border.StrokeShape>
                            <Entry Placeholder="Plan name"
                                   PlaceholderColor="{StaticResource SpendyDarkPlaceholder}"
                                   Text="{Binding Name, Mode=TwoWay}"
                                   TextColor="{StaticResource SpendyDarkLabel}"
                                   BackgroundColor="Transparent"
                                   VerticalOptions="Center" />
                        </Border>

                        <Grid>
                            <Border StrokeThickness="0"
                                    BackgroundColor="{StaticResource SpendyDarkInput}"
                                    Padding="16,0,48,0"
                                    HeightRequest="54">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="22" />
                                </Border.StrokeShape>
                                <Entry Placeholder="Target amount"
                                       Keyboard="Numeric"
                                       PlaceholderColor="{StaticResource SpendyDarkPlaceholder}"
                                       Text="{Binding TargetAmountText, Mode=TwoWay}"
                                       TextColor="{StaticResource SpendyDarkLabel}"
                                       BackgroundColor="Transparent"
                                       VerticalOptions="Center" />
                            </Border>
                            <Border WidthRequest="40"
                                    HeightRequest="40"
                                    HorizontalOptions="End"
                                    VerticalOptions="Center"
                                    Margin="0,0,10,0"
                                    BackgroundColor="#0E1F3A"
                                    StrokeThickness="0">
                                <Border.StrokeShape>
                                    <Ellipse />
                                </Border.StrokeShape>
                                <Label Text="₱"
                                       TextColor="White"
                                       FontAttributes="Bold"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       InputTransparent="True" />
                            </Border>
                        </Grid>

                        <Label Text="Start date"
                               Margin="0,4,0,0"
                               TextColor="{StaticResource SpendyDarkLabel}"
                               FontSize="14"
                               FontFamily="OpenSansSemibold" />
                        <Border BackgroundColor="{StaticResource SpendyDarkInput}"
                                StrokeThickness="0"
                                Padding="16,12"
                                HeightRequest="54">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="22" />
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenStartDatePickerCommand}" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="{Binding StartDateDisplay}"
                                       TextColor="{StaticResource SpendyDarkLabel}"
                                       FontSize="15"
                                       VerticalOptions="Center"
                                       LineBreakMode="TailTruncation" />
                                <Label Grid.Column="1"
                                       Text="&#x1F4C5;"
                                       FontSize="20"
                                       VerticalOptions="Center"
                                       Margin="8,0,0,0" />
                            </Grid>
                        </Border>

                        <Label Text="Target date"
                               Margin="0,4,0,0"
                               TextColor="{StaticResource SpendyDarkLabel}"
                               FontSize="14"
                               FontFamily="OpenSansSemibold" />
                        <Border BackgroundColor="{StaticResource SpendyDarkInput}"
                                StrokeThickness="0"
                                Padding="16,12"
                                HeightRequest="54">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="22" />
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenEndDatePickerCommand}" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="{Binding EndDateDisplay}"
                                       TextColor="{StaticResource SpendyDarkLabel}"
                                       FontSize="15"
                                       VerticalOptions="Center"
                                       LineBreakMode="TailTruncation" />
                                <Label Grid.Column="1"
                                       Text="&#x1F4C5;"
                                       FontSize="20"
                                       VerticalOptions="Center"
                                       Margin="8,0,0,0" />
                            </Grid>
                        </Border>

                        <Border BackgroundColor="#0E1F3A"
                                StrokeThickness="0"
                                Padding="16,14">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="18" />
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="6">
                                <Label Text="Duration"
                                       TextColor="{StaticResource SpendyDarkMuted}"
                                       FontSize="12"
                                       FontFamily="OpenSansSemibold" />
                                <Label Text="{Binding PlanDurationText}"
                                       TextColor="{StaticResource SpendyDarkSubtext}"
                                       FontSize="15"
                                       FontFamily="OpenSansSemibold" />
                            </VerticalStackLayout>
                        </Border>

                        <Button Text="Save Plan"
                                Command="{Binding SaveCommand}"
                                BackgroundColor="{StaticResource SpendyBlueDeep}"
                                TextColor="White"
                                FontFamily="OpenSansSemibold"
                                FontSize="16"
                                CornerRadius="26"
                                HeightRequest="54"
                                Margin="0,8,0,0" />
                    </VerticalStackLayout>
                </ScrollView>
            </Border>

            <Border BackgroundColor="#CC000000"
                    StrokeThickness="0"
                    IsVisible="{Binding ShowDateDimmer}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding CloseDateOverlayCommand}" />
                </Border.GestureRecognizers>
            </Border>

            <Border IsVisible="{Binding ShowStartDateOverlay}"
                    StrokeThickness="0"
                    BackgroundColor="{StaticResource SpendyDarkSheet}"
                    Margin="28,0"
                    Padding="20,18"
                    VerticalOptions="Center"
                    HorizontalOptions="Fill">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="22" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="14">
                    <Label Text="Start date"
                           TextColor="White"
                           FontFamily="OpenSansSemibold"
                           FontSize="18"
                           HorizontalTextAlignment="Center" />
                    <DatePicker Date="{Binding StartDate, Mode=TwoWay}"
                                Format="dddd, MMM d, yyyy"
                                TextColor="{StaticResource SpendyDarkLabel}"
                                BackgroundColor="{StaticResource SpendyDarkInput}"
                                MinimumHeightRequest="48" />
                    <Button Text="Done"
                            Command="{Binding CloseDateOverlayCommand}"
                            BackgroundColor="{StaticResource SpendyBlueDeep}"
                            TextColor="White"
                            FontFamily="OpenSansSemibold"
                            CornerRadius="22"
                            HeightRequest="48" />
                </VerticalStackLayout>
            </Border>

            <Border IsVisible="{Binding ShowEndDateOverlay}"
                    StrokeThickness="0"
                    BackgroundColor="{StaticResource SpendyDarkSheet}"
                    Margin="28,0"
                    Padding="20,18"
                    VerticalOptions="Center"
                    HorizontalOptions="Fill">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="22" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="14">
                    <Label Text="Target date"
                           TextColor="White"
                           FontFamily="OpenSansSemibold"
                           FontSize="18"
                           HorizontalTextAlignment="Center" />
                    <DatePicker Date="{Binding EndDate, Mode=TwoWay}"
                                Format="dddd, MMM d, yyyy"
                                MinimumDate="{Binding StartDate}"
                                TextColor="{StaticResource SpendyDarkLabel}"
                                BackgroundColor="{StaticResource SpendyDarkInput}"
                                MinimumHeightRequest="48" />
                    <Button Text="Done"
                            Command="{Binding CloseDateOverlayCommand}"
                            BackgroundColor="{StaticResource SpendyBlueDeep}"
                            TextColor="White"
                            FontFamily="OpenSansSemibold"
                            CornerRadius="22"
                            HeightRequest="48" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
