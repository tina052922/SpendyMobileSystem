<?xml version="1.0" encoding="utf-8" ?>

<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"

             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"

             xmlns:vm="clr-namespace:Spendy.ViewModels"

             x:Class="Spendy.Views.SettingsView"

             x:DataType="vm:SettingsViewModel">

    <ScrollView BackgroundColor="{StaticResource SpendyPageBg}">

        <VerticalStackLayout Padding="0,0,0,120" Spacing="0">

            <Grid Padding="16,12,16,18">

                <Grid.Background>

                    <SolidColorBrush Color="#01143D" />

                </Grid.Background>

                <Grid ColumnDefinitions="Auto,*,Auto">

                    <Border WidthRequest="44"

                            HeightRequest="44"

                            StrokeThickness="0"

                            BackgroundColor="#1AFFFFFF"

                            VerticalOptions="Center">

                        <Border.StrokeShape>

                            <Ellipse />

                        </Border.StrokeShape>

                        <Image Source="{Binding ProfilePhoto}" Aspect="AspectFill" />

                    </Border>

                    <VerticalStackLayout Grid.Column="1"

                                         Spacing="0"

                                         VerticalOptions="Center"

                                         Margin="12,0,0,0">

                        <Label Text="Settings"

                               TextColor="White"

                               FontFamily="OpenSansSemibold"

                               FontSize="20" />

                       

                    </VerticalStackLayout>

                    <Border Grid.Column="2"

                            WidthRequest="44"

                            HeightRequest="44"

                            StrokeThickness="0"

                            BackgroundColor="Transparent"

                            VerticalOptions="Center"

                            HorizontalOptions="End">

                        <Border.StrokeShape>

                            <Ellipse />

                        </Border.StrokeShape>

                        <Border.GestureRecognizers>

                            <TapGestureRecognizer Command="{Binding OpenNotificationsCommand}" />

                        </Border.GestureRecognizers>

                        <Image Source="whitenotificon.png"

                               WidthRequest="24"

                               HeightRequest="24"

                               Aspect="AspectFit"

                               HorizontalOptions="Center"

                               VerticalOptions="Center"

                               InputTransparent="True" />

                    </Border>

                </Grid>

            </Grid>



            <VerticalStackLayout Padding="24,14,24,0" Spacing="14">

                <!-- Single clean list card like reference -->

                <Border BackgroundColor="White"

                        StrokeThickness="0"

                        Padding="0">

                    <Border.StrokeShape>

                        <RoundRectangle CornerRadius="18" />

                    </Border.StrokeShape>



                    <VerticalStackLayout Spacing="0">

                        <!-- Profile -->

                        <Grid Padding="16" ColumnDefinitions="*,Auto">

                            <Grid.GestureRecognizers>

                                <TapGestureRecognizer Tapped="OnProfileTapped" />

                            </Grid.GestureRecognizers>

                            <Label Text="Profile"

                                   TextColor="{StaticResource SpendyNavy}"

                                   FontFamily="OpenSansSemibold"

                                   FontSize="15"

                                   VerticalOptions="Center" />

                            <Label Grid.Column="1"

                                   Text="›"

                                   TextColor="#98A2B3"

                                   FontSize="22"

                                   VerticalOptions="Center" />

                        </Grid>

                        <BoxView HeightRequest="1" Color="#EEF2F6" />



                        <!-- Currency -->

                        <Grid Padding="16" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">

                            <Grid.GestureRecognizers>

                                <TapGestureRecognizer Tapped="OnCurrencyTapped" />

                            </Grid.GestureRecognizers>

                            <Label Text="Currency"

                                   TextColor="{StaticResource SpendyNavy}"

                                   FontFamily="OpenSansSemibold"

                                   FontSize="15"

                                   VerticalOptions="Center" />

                            <Label Grid.Column="1"

                                   Text="{Binding SelectedCurrency}"

                                   TextColor="#667085"

                                   FontSize="14"

                                   VerticalOptions="Center" />

                            <Label Grid.Column="2"

                                   Text="›"

                                   TextColor="#98A2B3"

                                   FontSize="22"

                                   VerticalOptions="Center" />

                        </Grid>

                        <BoxView HeightRequest="1" Color="#EEF2F6" />

                        <!-- Update Password (expand/collapse) -->

                        <Grid Padding="16" ColumnDefinitions="*,Auto">

                            <Grid.GestureRecognizers>

                                <TapGestureRecognizer Tapped="OnTogglePassword" />

                            </Grid.GestureRecognizers>

                            <Label Text="Update Password"

                                   TextColor="{StaticResource SpendyNavy}"

                                   FontFamily="OpenSansSemibold"

                                   FontSize="15"

                                   VerticalOptions="Center" />

                            <Label x:Name="Chevron"

                                   Grid.Column="1"

                                   Text="⌄"

                                   TextColor="#98A2B3"

                                   FontSize="22"

                                   VerticalOptions="Center" />

                        </Grid>



                        <!-- Update password: light fields aligned with white settings card -->

                        <VerticalStackLayout x:Name="PasswordFields"

                                             IsVisible="True"

                                             BackgroundColor="White"

                                             Padding="16,10,16,20"

                                             Spacing="16">

                            <BoxView HeightRequest="1" Color="#EEF2F6" />

                            <VerticalStackLayout Spacing="6">

                                <Label Text="Current password"

                                       TextColor="{StaticResource SpendyNavy}"

                                       FontFamily="OpenSansSemibold"

                                       FontSize="14" />

                                <Border BackgroundColor="#F9FAFB"

                                        Stroke="#E4E7EC"

                                        StrokeThickness="1"

                                        Padding="12,0,8,0"

                                        MinimumHeightRequest="52">

                                    <Border.StrokeShape>

                                        <RoundRectangle CornerRadius="14" />

                                    </Border.StrokeShape>

                                    <Grid ColumnDefinitions="*,Auto"

                                          ColumnSpacing="10"

                                          VerticalOptions="Center"

                                          Padding="0,8">

                                        <Entry x:Name="CurrentPassword"

                                               Text="{Binding CurrentPassword}"

                                               IsPassword="True"

                                               Placeholder="Enter current password"

                                               PlaceholderColor="#98A2B3"

                                               TextColor="{StaticResource SpendyNavy}"

                                               FontSize="15"

                                               BackgroundColor="Transparent"

                                               VerticalOptions="Center"

                                               MinimumHeightRequest="40" />

                                        <Border Grid.Column="1"

                                                BackgroundColor="#EEF2F6"

                                                StrokeThickness="0"

                                                WidthRequest="40"

                                                HeightRequest="40"

                                                VerticalOptions="Center">

                                            <Border.StrokeShape>

                                                <RoundRectangle CornerRadius="12" />

                                            </Border.StrokeShape>

                                            <ImageButton Source="unhide.png"

                                                         BackgroundColor="Transparent"

                                                         Padding="8"

                                                         WidthRequest="40"

                                                         HeightRequest="40"

                                                         VerticalOptions="Center"

                                                         HorizontalOptions="Center"

                                                         Clicked="OnToggleCurrent" />

                                        </Border>

                                    </Grid>

                                </Border>

                            </VerticalStackLayout>

                            <VerticalStackLayout Spacing="6">

                                <Label Text="New password"

                                       TextColor="{StaticResource SpendyNavy}"

                                       FontFamily="OpenSansSemibold"

                                       FontSize="14" />

                                <Border BackgroundColor="#F9FAFB"

                                        Stroke="#E4E7EC"

                                        StrokeThickness="1"

                                        Padding="12,0,8,0"

                                        MinimumHeightRequest="52">

                                    <Border.StrokeShape>

                                        <RoundRectangle CornerRadius="14" />

                                    </Border.StrokeShape>

                                    <Grid ColumnDefinitions="*,Auto"

                                          ColumnSpacing="10"

                                          VerticalOptions="Center"

                                          Padding="0,8">

                                        <Entry x:Name="NewPassword"

                                               Text="{Binding NewPassword}"

                                               IsPassword="True"

                                               Placeholder="Enter new password"

                                               PlaceholderColor="#98A2B3"

                                               TextColor="{StaticResource SpendyNavy}"

                                               FontSize="15"

                                               BackgroundColor="Transparent"

                                               VerticalOptions="Center"

                                               MinimumHeightRequest="40" />

                                        <Border Grid.Column="1"

                                                BackgroundColor="#EEF2F6"

                                                StrokeThickness="0"

                                                WidthRequest="40"

                                                HeightRequest="40"

                                                VerticalOptions="Center">

                                            <Border.StrokeShape>

                                                <RoundRectangle CornerRadius="12" />

                                            </Border.StrokeShape>

                                            <ImageButton Source="unhide.png"

                                                         BackgroundColor="Transparent"

                                                         Padding="8"

                                                         WidthRequest="40"

                                                         HeightRequest="40"

                                                         VerticalOptions="Center"

                                                         HorizontalOptions="Center"

                                                         Clicked="OnToggleNew" />

                                        </Border>

                                    </Grid>

                                </Border>

                            </VerticalStackLayout>

                            <VerticalStackLayout Spacing="6">

                                <Label Text="Confirm new password"

                                       TextColor="{StaticResource SpendyNavy}"

                                       FontFamily="OpenSansSemibold"

                                       FontSize="14" />

                                <Border BackgroundColor="#F9FAFB"

                                        Stroke="#E4E7EC"

                                        StrokeThickness="1"

                                        Padding="12,0,8,0"

                                        MinimumHeightRequest="52">

                                    <Border.StrokeShape>

                                        <RoundRectangle CornerRadius="14" />

                                    </Border.StrokeShape>

                                    <Grid ColumnDefinitions="*,Auto"

                                          ColumnSpacing="10"

                                          VerticalOptions="Center"

                                          Padding="0,8">

                                        <Entry x:Name="ConfirmPassword"

                                               Text="{Binding ConfirmNewPassword}"

                                               IsPassword="True"

                                               Placeholder="Confirm new password"

                                               PlaceholderColor="#98A2B3"

                                               TextColor="{StaticResource SpendyNavy}"

                                               FontSize="15"

                                               BackgroundColor="Transparent"

                                               VerticalOptions="Center"

                                               MinimumHeightRequest="40" />

                                        <Border Grid.Column="1"

                                                BackgroundColor="#EEF2F6"

                                                StrokeThickness="0"

                                                WidthRequest="40"

                                                HeightRequest="40"

                                                VerticalOptions="Center">

                                            <Border.StrokeShape>

                                                <RoundRectangle CornerRadius="12" />

                                            </Border.StrokeShape>

                                            <ImageButton Source="unhide.png"

                                                         BackgroundColor="Transparent"

                                                         Padding="8"

                                                         WidthRequest="40"

                                                         HeightRequest="40"

                                                         VerticalOptions="Center"

                                                         HorizontalOptions="Center"

                                                         Clicked="OnToggleConfirm" />

                                        </Border>

                                    </Grid>

                                </Border>

                            </VerticalStackLayout>

                            <Label Text="{Binding NewPasswordStrengthLabel}"

                                   FontSize="12"

                                   FontFamily="OpenSansSemibold"

                                   TextColor="{Binding NewPasswordStrengthColor}"

                                   Margin="0,2,0,0" />

                            <Button Text="Update Password"

                                    BackgroundColor="{StaticResource SpendyBlueDeep}"

                                    TextColor="White"

                                    FontFamily="OpenSansSemibold"

                                    FontSize="16"

                                    CornerRadius="26"

                                    HeightRequest="54"

                                    Margin="0,4,0,0"

                                    Command="{Binding UpdatePasswordCommand}" />

                        </VerticalStackLayout>

                        <BoxView HeightRequest="1" Color="#EEF2F6" />

                        <!-- Log out (neutral) -->

                        <Grid Padding="16" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">

                            <Grid.GestureRecognizers>

                                <TapGestureRecognizer Tapped="OnLogoutTapped" />

                            </Grid.GestureRecognizers>

                            <Image Source="logouticon.png"

                                   WidthRequest="20"

                                   HeightRequest="20"

                                   Aspect="AspectFit"

                                   VerticalOptions="Center" />

                            <Label Grid.Column="1"

                                   Text="Log out"

                                   TextColor="{StaticResource SpendyNavy}"

                                   FontFamily="OpenSansSemibold"

                                   FontSize="15"

                                   VerticalOptions="Center" />

                            <Label Grid.Column="2"

                                   Text="›"

                                   TextColor="#98A2B3"

                                   FontSize="22"

                                   VerticalOptions="Center" />

                        </Grid>

                    </VerticalStackLayout>

                </Border>

            </VerticalStackLayout>

        </VerticalStackLayout>

    </ScrollView>

</ContentView>

