<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Spendy.ViewModels"
             xmlns:models="clr-namespace:Spendy.Models"
             x:Class="Spendy.Views.TransactionHistoryPage"
             x:DataType="vm:TransactionHistoryViewModel"
             Shell.NavBarIsVisible="False"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource SpendyPageBg}">

    <Grid RowDefinitions="Auto,*">
        <Grid Padding="16,12,16,18" BackgroundColor="{StaticResource SpendyNavy}">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <Button Text="‹"
                        WidthRequest="40"
                        HeightRequest="40"
                        CornerRadius="20"
                        BackgroundColor="#1AFFFFFF"
                        TextColor="White"
                        FontSize="18"
                        Command="{Binding BackCommand}" />

                <Label Grid.Column="1"
                       Text="{Binding Title}"
                       TextColor="White"
                       FontFamily="OpenSansSemibold"
                       FontSize="16"
                       HorizontalTextAlignment="Center"
                       VerticalOptions="Center" />

                <ActivityIndicator Grid.Column="2"
                                   IsRunning="{Binding IsBusy}"
                                   IsVisible="{Binding IsBusy}"
                                   Color="White"
                                   VerticalOptions="Center" />
            </Grid>
        </Grid>

        <Border Grid.Row="1"
                BackgroundColor="White"
                StrokeThickness="0"
                Padding="16"
                Margin="0,0,0,120">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="24,24,0,0" />
            </Border.StrokeShape>

            <CollectionView ItemsSource="{Binding Items}"
                            SelectionMode="None">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="10" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:TransactionItem">
                        <Border BackgroundColor="#F8FAFC"
                                StrokeThickness="0"
                                Padding="12">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16" />
                            </Border.StrokeShape>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <Border WidthRequest="36"
                                        HeightRequest="36"
                                        BackgroundColor="{StaticResource SpendyNavy}"
                                        StrokeThickness="0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="10" />
                                    </Border.StrokeShape>
                                    <Label Text="{Binding Icon}"
                                           FontSize="18"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                    <Label Text="{Binding Category}"
                                           TextColor="{StaticResource SpendyNavy}"
                                           FontAttributes="Bold" />
                                    <Label Text="{Binding DetailNote}"
                                           IsVisible="{Binding HasDetailNote}"
                                           TextColor="{StaticResource SpendyMutedText}"
                                           FontSize="12"
                                           LineBreakMode="WordWrap" />
                                    <Label Text="{Binding Time}"
                                           TextColor="{StaticResource SpendyMutedText}"
                                           FontSize="12" />
                                </VerticalStackLayout>
                                <Label Grid.Column="2"
                                       Text="{Binding FormattedAmount}"
                                       TextColor="{Binding AmountColor}"
                                       FontSize="14"
                                       HorizontalTextAlignment="End"
                                       VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Border>
    </Grid>
</ContentPage>

